# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/supermart

# JWT Secret — use a long random string
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_key

# Token expiry
JWT_EXPIRES_IN=7d

# Backend port
PORT=5000

# Environment
NODE_ENV=development

# Frontend URL (for CORS) — change in production
CLIENT_URL=http://localhost:5173
